/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model text_code_registry {
  text_code_registry_id Int      @id @default(autoincrement())
  instance_id           Int
  code_key              String   @db.VarChar(50)
  code_text             String   @db.VarChar(500)
  is_active             Boolean? @default(true)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  created_by            Int      @default(1)
  updated_at            DateTime @default(now()) @db.Timestamp(6)
  updated_by            Int      @default(1)
  category              String   @default("text_code") @db.VarChar(100)
  instances             Instance @relation(fields: [instance_id], references: [instanceId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([instance_id, category, code_key])
  @@unique([instance_id, category, code_text])
  @@schema("configurations")
}

model model_files_registry {
  instance_id             Int
  model_id                Int
  file_name               String   @db.VarChar(255)
  model_file_display_name String   @db.VarChar(255)
  model_data              Bytes
  model_metadata          Json?    @db.JsonB
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @default(now()) @db.Timestamp(6)

  @@id([instance_id, model_id, file_name])
  @@schema("output")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model capability_configurations {
  capability_config_id            Int                          @id @default(autoincrement())
  capability_id                   Int
  config_data_key                 String                       @db.VarChar(64)
  config_data                     Bytes
  parent_capability_config_id     Int?
  is_active                       Boolean                      @default(true)
  created_at                      DateTime                     @default(now()) @db.Timestamp(6)
  created_by                      Int?                         @default(3)
  updated_at                      DateTime                     @default(now()) @db.Timestamp(6)
  updated_by                      Int?                         @default(3)
  capability                      Capability                   @relation(fields: [capability_id], references: [capabilityId], onDelete: NoAction, onUpdate: NoAction)
  capability_configurations       capability_configurations?   @relation("capability_configurationsTocapability_configurations", fields: [parent_capability_config_id], references: [capability_config_id], onDelete: NoAction, onUpdate: NoAction)
  other_capability_configurations capability_configurations[]  @relation("capability_configurationsTocapability_configurations")
  created_by_user                 User?                        @relation("CapabilityConfigCreatedBy", fields: [created_by], references: [userId], onDelete: SetNull, onUpdate: Cascade)
  updated_by_user                 User?                        @relation("CapabilityConfigUpdatedBy", fields: [updated_by], references: [userId], onDelete: SetNull, onUpdate: Cascade)

  @@unique([capability_id, config_data_key])
  @@schema("configurations")
}

enum BuildStatus {
  QUEUED
  SUCCESSFUL
  FAILED
  BUILD_IN_PROGRESS

  @@schema("configurations")
}

enum schedule_status {
  ACTIVE
  PAUSED

  @@schema("configurations")
}
