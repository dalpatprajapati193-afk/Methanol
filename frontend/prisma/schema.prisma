model TagRegistry {
  tagId             Int                  @id(map: "tags_pkey") @default(autoincrement()) @map("tag_id")
  instanceId        Int                  @map("instance_id")
  tagKey            String               @map("tag_key")
  tagDisplay        String?              @map("tag_display")
  tagType           String?              @map("tag_type")
  tagAlias          String?              @map("tag_alias")
  uomId             Int?                 @map("uom_id")
  unitOfMeasurement unit_of_measurement? @relation(fields: [uomId], references: [uom_id], onDelete: NoAction, onUpdate: NoAction)
  tagExpression     String?              @map("tag_expression")
  isActive          Boolean              @default(true) @map("is_active")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime             @default(now()) @map("updated_at") @db.Timestamp(6)
  createdBy         Int?                 @map("created_by")
  updatedBy         Int?                 @map("updated_by")
  instance          Instance             @relation(fields: [instanceId], references: [instanceId], onDelete: Cascade, onUpdate: NoAction, map: "fk_tags_instance")

  @@unique([instanceId, tagKey], map: "uk_tags_instance_tag_key")
  @@map("tag_registry")
  @@schema("configurations")
}

model HierarchyMaster {
  hierarchyMasterId    BigInt            @id @default(autoincrement()) @map("hierarchy_master_id")
  hierarchyKey         String            @map("hierarchy_key") @db.VarChar(100)
  hierarchyDisplayName String            @map("hierarchy_display_name") @db.VarChar(255)
  hierarchyTypeId      Int               @map("hierarchy_type_id")
  isActive             Boolean           @default(true) @map("is_active")
  parentHierarchyId    BigInt?           @map("parent_hierarchy_id")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime          @default(now()) @map("updated_at") @db.Timestamp(6)
  instances            Instance[]
  parentHierarchy      HierarchyMaster?  @relation("HierarchyMasterToHierarchyMaster", fields: [parentHierarchyId], references: [hierarchyMasterId], onDelete: NoAction, onUpdate: NoAction, map: "fk_hierarchy_master_parent")
  childHierarchies     HierarchyMaster[] @relation("HierarchyMasterToHierarchyMaster")

  @@map("hierarchy_master")
  @@schema("enterprise_master")
}

model HierarchyType {
  hierarchyTypeId       Int      @id @default(autoincrement()) @map("hierarchy_type_id")
  hierarchyTypeName     String   @map("hierarchy_typename") @db.VarChar(100)
  hierarchyDisplayName  String   @map("hierarchy_display_name") @db.VarChar(255)
  parentHierarchyTypeId Int?     @map("parent_hierarchy_type_id")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  sort_id               Int?

  @@map("hierarchy_type")
  @@schema("enterprise_master")
}

