model imputation_policy {
  imputation_policy_id Int          @id @default(autoincrement())
  policy_type          String       @db.VarChar(50)
  policy_action        String       @db.VarChar(50)
  policy_description   String       @db.VarChar(100)
  policy_display_text  String       @db.VarChar(100)
  warning_flag         Int          @default(0) @db.SmallInt
  skip_flag            Int          @default(0) @db.SmallInt
  model_status_id      Int
  is_active            Boolean      @default(true)
  created_at           DateTime     @default(now()) @db.Timestamp(6)
  created_by           Int          @default(1)
  updated_at           DateTime     @default(now()) @db.Timestamp(6)
  updated_by           Int          @default(1)
  model_status         model_status @relation(fields: [model_status_id], references: [model_status_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([policy_type, policy_action])
  @@schema("configurations")
}

model instance_configuration_drafts {
  instance_configuration_draft_id Int      @id @default(autoincrement())
  instance_id                     Int
  draft_data                      Json
  current_step                    String?  @db.VarChar(48)
  created_at                      DateTime @default(now()) @db.Timestamp(6)
  updated_at                      DateTime @default(now()) @db.Timestamp(6)
  instances                       Instance @relation(fields: [instance_id], references: [instanceId], onDelete: NoAction, onUpdate: NoAction)

  @@schema("configurations")
}

model model_alert_registry {
  alert_id                Int           @id @default(autoincrement())
  instance_id             Int
  alert_type              String        @db.VarChar(50)
  alert_action            String        @db.VarChar(50)
  alert_description       String?       @db.VarChar(100)
  alert_display_text      String?       @db.VarChar(100)
  warning_flag            Int           @default(0) @db.SmallInt
  skip_flag               Int           @default(0) @db.SmallInt
  model_status_id         Int?
  is_active               Boolean?      @default(true)
  created_at              DateTime      @default(now()) @db.Timestamp(6)
  created_by              Int           @default(1)
  updated_at              DateTime      @default(now()) @db.Timestamp(6)
  updated_by              Int           @default(1)
  instance_configurations Instance      @relation(fields: [instance_id], references: [instanceId], onDelete: NoAction, onUpdate: NoAction)
  model_status            model_status? @relation(fields: [model_status_id], references: [model_status_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([instance_id, alert_type, alert_action])
  @@schema("configurations")
}

model model_registry {
  model_id                Int              @id @default(autoincrement())
  instance_id             Int
  model_key               String           @db.VarChar(50)
  model_description       String?          @db.VarChar(100)
  is_active               Boolean?         @default(true)
  created_at              DateTime         @default(now()) @db.Timestamp(6)
  created_by              Int              @default(1)
  updated_at              DateTime         @default(now()) @db.Timestamp(6)
  updated_by              Int              @default(1)
  model_alias             String           @db.VarChar(50)
  parent_model_id         Int?
  instance_configurations Instance         @relation(fields: [instance_id], references: [instanceId], onDelete: NoAction, onUpdate: NoAction)
  model_registry          model_registry?  @relation("model_registryTomodel_registry", fields: [parent_model_id], references: [model_id], onDelete: NoAction, onUpdate: NoAction)
  other_model_registry    model_registry[] @relation("model_registryTomodel_registry")

  @@unique([instance_id, model_key])
  @@unique([instance_id, model_alias])
  @@schema("configurations")
}

model model_status {
  model_status_id      Int                    @id @default(autoincrement())
  status_code          String                 @unique @db.VarChar(32)
  description          String                 @db.VarChar(100)
  display_text         String                 @db.VarChar(100)
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  created_by           Int                    @default(1)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_by           Int                    @default(1)
  imputation_policy    imputation_policy[]
  model_alert_registry model_alert_registry[]

  @@schema("configurations")
}

model unit_of_measurement {
  uom_id                    Int                   @id @default(autoincrement())
  uom_symbol                String                @unique @db.VarChar(32)
  uom_name                  String                @db.VarChar(100)
  category                  String                @db.VarChar(100)
  ref_uom_id                Int
  ref_factor                Decimal               @default(1) @db.Decimal
  ref_offset                Decimal               @default(0) @db.Decimal
  source                    String                @default("system") @db.VarChar(16)
  description               String?               @db.VarChar(100)
  is_active                 Boolean               @default(true)
  created_at                DateTime              @default(now()) @db.Timestamp(6)
  created_by                Int                   @default(1)
  updated_at                DateTime              @default(now()) @db.Timestamp(6)
  updated_by                Int                   @default(1)
  tag_registry              TagRegistry[]
  unit_of_measurement       unit_of_measurement   @relation("unit_of_measurementTounit_of_measurement", fields: [ref_uom_id], references: [uom_id], onDelete: NoAction, onUpdate: NoAction)
  other_unit_of_measurement unit_of_measurement[] @relation("unit_of_measurementTounit_of_measurement")

  @@schema("configurations")
}

