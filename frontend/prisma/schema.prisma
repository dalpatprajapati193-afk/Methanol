generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["configurations", "enterprise_master", "output"]
}

model User {
  userId                  Int                @id @default(autoincrement()) @map("user_id")
  userName                String             @map("user_name") @db.VarChar(100)
  userEmail               String             @map("user_email") @db.VarChar(100)
  userPassword            String             @map("user_password") @db.VarChar(100)
  createdAt               DateTime           @default(now()) @map("created_at")
  createdBy               Int?               @map("created_by")
  isActive                Boolean            @default(true) @map("is_active")
  updatedAt               DateTime           @default(now()) @updatedAt @map("updated_at")
  capabilities            Capability[]
  instances               Instance[]
  moduleTypes             ModuleType[]
  plantTypes              PlantType[]
  systemTypes             SystemType[]
  userCapabilitiesCreated UserCapability[]   @relation("UserCapabilityCreatedBy")
  userCapabilities        UserCapability[]   @relation("UserCapabilityToUser")
  userGroups              UserGroupMapping[]
  createdByUser           User?              @relation("UserCreatedBy", fields: [createdBy], references: [userId])
  createdUsers            User[]             @relation("UserCreatedBy")
  apiTokens               ApiToken[]
  capabilityConfigurationsCreated capability_configurations[] @relation("CapabilityConfigCreatedBy")
  capabilityConfigurationsUpdated capability_configurations[] @relation("CapabilityConfigUpdatedBy")

  @@map("users")
  @@schema("configurations")
}

model ApiToken {
  tokenId    Int       @id @default(autoincrement()) @map("token_id")
  userId     Int       @map("user_id")
  name       String    @map("name") @db.VarChar(100)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
  @@schema("configurations")
}

model PlantType {
  plantTypeId   Int          @id @default(autoincrement()) @map("plant_type_id")
  plantTypeName String       @map("plant_type_name") @db.VarChar(100)
  createdAt     DateTime     @default(now()) @map("created_at")
  createdBy     Int?         @map("created_by")
  isActive      Boolean      @default(true) @map("is_active")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  capabilities  Capability[]
  createdByUser User?        @relation(fields: [createdBy], references: [userId])

  @@map("plants_types")
  @@schema("configurations")
}

model ModuleType {
  moduleTypeId   Int          @id @default(autoincrement()) @map("module_type_id")
  moduleTypeName String       @map("module_type_name") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      Int?         @map("created_by")
  isActive       Boolean      @default(true) @map("is_active")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  image_src      String?
  url_slug       String?      @unique(map: "modules_types_unique")
  sort_id        Int?
  capabilities   Capability[]
  createdByUser  User?        @relation(fields: [createdBy], references: [userId])

  @@map("modules_types")
  @@schema("configurations")
}

model SystemType {
  systemTypeId   Int          @id @default(autoincrement()) @map("system_type_id")
  systemTypeName String       @map("system_type_name") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      Int?         @map("created_by")
  isActive       Boolean      @default(true) @map("is_active")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  capabilities   Capability[]
  createdByUser  User?        @relation(fields: [createdBy], references: [userId])

  @@map("systems_types")
  @@schema("configurations")
}

model Capability {
  capabilityId     Int              @id @default(autoincrement()) @map("capability_id")
  moduleType       Int              @map("module_type")
  plantType        Int              @map("plant_type")
  systemType       Int              @map("system_type")
  createdAt        DateTime         @default(now()) @map("created_at")
  createdBy        Int?             @map("created_by")
  isActive         Boolean          @default(true) @map("is_active")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  folderMapping    String           @default("default") @map("folder_mapping") @db.VarChar(100)
  createdByUser    User?            @relation(fields: [createdBy], references: [userId])
  moduleTypeRel    ModuleType       @relation(fields: [moduleType], references: [moduleTypeId])
  plantTypeRel     PlantType        @relation(fields: [plantType], references: [plantTypeId])
  systemTypeRel    SystemType       @relation(fields: [systemType], references: [systemTypeId])
  instances        Instance[]
  userCapabilities UserCapability[]
  capabilityConfigurations capability_configurations[]

  @@map("capabilities")
  @@schema("configurations")
}

model UserCapability {
  userCapabilityId Int        @id @default(autoincrement()) @map("user_capability_id")
  userId           Int        @map("user_id")
  capabilityId     Int        @map("capability_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  createdBy        Int?       @map("created_by")
  isActive         Boolean    @default(true) @map("is_active")
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")
  capability       Capability @relation(fields: [capabilityId], references: [capabilityId])
  createdByUser    User?      @relation("UserCapabilityCreatedBy", fields: [createdBy], references: [userId])
  user             User       @relation("UserCapabilityToUser", fields: [userId], references: [userId])

  @@map("user_capabilities")
  @@schema("configurations")
}

model Instance {
  instanceId                    Int                             @id @default(autoincrement()) @map("instance_id")
  capabilityId                  Int                             @map("capability_id")
  instanceName                  String                          @map("instance_name") @db.VarChar(100)
  createdAt                     DateTime                        @default(now()) @map("created_at")
  createdBy                     Int?                            @map("created_by")
  isActive                      Boolean                         @default(true) @map("is_active")
  updatedAt                     DateTime                        @default(now()) @updatedAt @map("updated_at")
  hierarchyMasterId             BigInt?                         @map("hierarchy_master_id")
  instance_configuration_drafts instance_configuration_drafts[]
  configuration                 InstanceConfiguration?
  hierarchyMaster               HierarchyMaster?                @relation(fields: [hierarchyMasterId], references: [hierarchyMasterId], onDelete: NoAction, onUpdate: NoAction, map: "fk_instance_hierarchy_master")
  capability                    Capability                      @relation(fields: [capabilityId], references: [capabilityId])
  createdByUser                 User?                           @relation(fields: [createdBy], references: [userId])
  model_alert_registry          model_alert_registry[]
  model_registry                model_registry[]
  tagRegistry                   TagRegistry[]
  text_code_registry            text_code_registry[]

  @@map("instances")
  @@schema("configurations")
}

model InstanceConfiguration {
  instance_configurations_id Int      @id @default(autoincrement())
  instanceId                 Int      @unique @map("instance_id")
  pipeline_config_data       Bytes
  ui_config_data             Json?
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  created_by                 Int      @default(1)
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  updated_by                 Int      @default(1)
  instance                   Instance @relation(fields: [instanceId], references: [instanceId], onDelete: NoAction, onUpdate: NoAction)

  @@map("instance_configurations")
  @@schema("configurations")
}

model SecurityGroup {
  groupId          Int                            @id @default(autoincrement()) @map("group_id")
  groupName        String                         @unique @map("group_name") @db.VarChar(100)
  description      String?                        @db.VarChar(255)
  createdAt        DateTime                       @default(now()) @map("created_at")
  createdBy        Int?                           @map("created_by")
  isActive         Boolean                        @default(true) @map("is_active")
  updatedAt        DateTime                       @default(now()) @updatedAt @map("updated_at")
  resourceMappings SecurityGroupResourceMapping[]
  users            UserGroupMapping[]

  @@map("security_groups")
  @@schema("configurations")
}

model UserGroupMapping {
  userId    Int           @map("user_id")
  groupId   Int           @map("group_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")
  group     SecurityGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_group_mappings")
  @@schema("configurations")
}

model Resource {
  resourceId    Int                            @id @default(autoincrement()) @map("resource_id")
  title         String                         @map("title") @db.VarChar(100)
  url           String?                        @map("url") @db.VarChar(255)
  description   String?                        @map("description") @db.VarChar(500)
  isActive      Boolean                        @default(true) @map("is_active")
  icon          String?                        @map("icon") @db.VarChar(50)
  resourceType  String                         @map("resource_type") @db.VarChar(50)
  resourceArea  String                         @map("resource_area") @db.VarChar(50)
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @default(now()) @updatedAt @map("updated_at")
  groupMappings SecurityGroupResourceMapping[]

  @@map("resources")
  @@schema("configurations")
}

model SecurityGroupResourceMapping {
  id         Int                 @id @default(autoincrement())
  groupId    Int                 @map("security_group_id")
  resourceId Int                 @map("resource_id")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @default(now()) @updatedAt @map("updated_at")
  ace        AccessControlEntry?
  resource   Resource            @relation(fields: [resourceId], references: [resourceId], onDelete: Cascade)
  group      SecurityGroup       @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@unique([groupId, resourceId])
  @@map("security_group_resource_mapping")
  @@schema("configurations")
}

model AccessControlEntry {
  aceId     Int                          @id @default(autoincrement()) @map("ace_id")
  mappingId Int                          @unique @map("security_group_resource_mapping_id")
  canCreate Boolean                      @default(false) @map("can_create")
  canRead   Boolean                      @default(true) @map("can_read")
  canUpdate Boolean                      @default(false) @map("can_update")
  canDelete Boolean                      @default(false) @map("can_delete")
  isAllowed Boolean                      @default(true) @map("is_allowed")
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @default(now()) @updatedAt @map("updated_at")
  mapping   SecurityGroupResourceMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@map("access_control_entries")
  @@schema("configurations")
}

