DATABASE_URL=
JWT_SECRET=
# NextAuth SSO Configuration
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
NEXTAUTH_URL=http://localhost:3000
# Historian — read once at startup, so restart FastAPI after any change.
# HISTORIAN_URL is required; HISTORIAN_TOKEN is the bearer token (required for the
# centralized historian, leave blank for a local replica).
#
# To switch, set ONE HISTORIAN_URL (comment the other) and its matching token.
#
# Local replica (no auth) — default for local dev:
#HISTORIAN_URL=http://localhost:8200
#HISTORIAN_TOKEN=
#
# Centralized ("Olympic") historian — comment the two lines above, uncomment these,
# and fill in your token:
# HISTORIAN_URL=https://ingenero360ix.centralindia.cloudapp.azure.com/historian/
# HISTORIAN_TOKEN=<your-bearer-token>
