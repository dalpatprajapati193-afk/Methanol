{
  "name": "ingenero-af",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npx prisma generate&&next dev -H 0.0.0.0",
    "build": "npx prisma generate&&next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:ui": "dotenv -e .env.test -- vitest --ui",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "test:db:reset": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.34.3",
    "install": "^0.13.0",
    "jose": "^6.2.2",
    "jotai": "^2.20.1",
    "lucide-react": "^0.575.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^6.9.0",
    "npm": "^11.16.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-select": "^5.10.2",
    "react-hook-form": "^7.80.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.35",
    "@vitest/ui": "^4.1.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "next-auth": {
      "next": "$next",
      "nodemailer": "$nodemailer"
    }
  }
}
